          "text": "Z + H2O X + Y",
          "wingding": "F0E0",
          "wingdingFont": "Wingdings"
        },
        {
          "key": "B",
          "text": "Z X + Y + H2O",
          "wingding": "F0E0",
          "wingdingFont": "Wingdings"
        },
        {
          "key": "C",
          "text": "X + Y Z + H2O",
          "wingding": "F0E0",
          "wingdingFont": "Wingdings"
        },
        {
          "key": "D",
          "text": "X + Y + H2O Z",
          "wingding": "F0E0",
          "wingdingFont": "Wingdings"
