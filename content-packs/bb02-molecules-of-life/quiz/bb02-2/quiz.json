          "key": "A",
          "text": "(1) only"
        },
        {
          "key": "B",
          "text": "(1) and (2) only"
        },
        {
          "key": "C",
          "text": "(1) and (3) only"
        },
        {
          "key": "D",
          "text": "(1), (2) and (3)"
        }
      ],
      "answer": "A",
      "hint": "Review 2.2 Water.",
