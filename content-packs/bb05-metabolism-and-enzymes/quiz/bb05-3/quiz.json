    {
      "id": "BB05.3-5",
      "topic": "BB05",
      "section": "BB05.3",
      "difficulty": "Advanced",
      "stem": "Enzymes are important to seeds during germination. Which of the following is the main function of these enzymes in germinating seeds?",
      "options": [
        {
          "key": "A",
          "text": "to synthesize starch from sugars for storage"
        },
        {
          "key": "B",
          "text": "to increase the rate of water absorption in the root"
        },
        {
          "key": "C",
          "text": "to break down insoluble food into soluble forms"
        },
        {
          "key": "D",
          "text": "to carry out photosynthesis"
        }
      ],
      "answer": "C",
      "hint": "Review 5.3 Enzyme action and properties."
    },
    {
      "id": "BB05.3-6",
      "topic": "BB05",
      "section": "BB05.3",
      "difficulty": "Advanced",
      "stem": "Given a solution containing starch, amylase and lipase, which of the following tests will give a negative result to this solution?",
      "options": [
        {
          "key": "A",
          "text": "iodine test"
        },
        {
          "key": "B",
          "text": "Benedict’s test"
        },
        {
          "key": "C",
          "text": "testing with a protein test strip"
        },
        {
          "key": "D",
          "text": "grease spot test"
        }
      ],
      "answer": "D",
      "hint": "Review 5.3 Enzyme action and properties."
    },
