        {
          "key": "C",
          "text": "to kill the cells"
        },
        {
          "key": "D",
          "text": "to make transparent structures easier to be observed"
        }
      ],
      "answer": "D",
      "hint": "Review 3.2 Introduction to microscopes."
    },
